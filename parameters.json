{
    "activation": "gelu",
    "align_pose_frontview": false,
    "archiname": "transformer",
    "batch_size": 20,
    "clip_image_losses": [
        "cosine"
    ],
    "clip_lambda_ce": 1.0,
    "clip_lambda_cosine": 1.0,
    "clip_lambda_mse": 1.0,
    "clip_lambdas": {
        "image": {
            "cosine": 1.0
        },
        "text": {
            "cosine": 1.0
        }
    },
    "clip_map_images": false,
    "clip_map_text": false,
    "clip_mappers_type": "no_mapper",
    "clip_text_losses": [
        "cosine"
    ],
    "cuda": true,
    "datapath": "./data/amass_db/babel_30fps_db.pt",
    "dataset": "amass",
    "debug": false,
    "device": "cuda:0",
    "expname": "exps",
    "folder": "./exps/classes-model",
    "glob": true,
    "glob_rot": [
        3.141592653589793,
        0,
        0
    ],
